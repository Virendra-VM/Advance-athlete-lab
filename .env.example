# Backend database connection
DATABASE_URL=postgresql+psycopg2://athlete:athlete@localhost:5433/athlete_lab

# Frontend API base URL
VITE_API_URL=http://localhost:8000

# Strava OAuth (backend only — copy these into backend/.env)
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:5173/oauth/strava/callback

# Strava Webhook validation (choose any secret string; must match Strava subscription)
STRAVA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Strava bulk export import (backend only)
STRAVA_EXPORT_DIR=/Users/you/Downloads/strava_export
ACTIVITY_POINTS_DIR=./data/activity_points

# COROS official MCP (OAuth 2.1 PKCE + remote MCP)
COROS_MCP_URL=https://mcp.coros.com/mcp
COROS_REDIRECT_URI=http://localhost:5173/oauth/coros/callback
# Optional: pin a dynamic-registration client id (otherwise auto-created under backend/data/)
# COROS_MCP_CLIENT_ID=
COROS_FIT_DAILY_LIMIT=50
COROS_ACTIVITY_LOOKBACK_DAYS=90
COROS_HEALTH_LOOKBACK_DAYS=28
