# Backend database connection
DATABASE_URL=postgresql+psycopg2://athlete:athlete@localhost:5433/athlete_lab

# Frontend API base URL
VITE_API_URL=http://localhost:8000

# Strava OAuth (backend only — copy these into backend/.env)
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:5173/oauth/strava/callback

# Strava Webhook validation (choose any secret string; must match Strava subscription)
STRAVA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Strava bulk export import (backend only)
STRAVA_EXPORT_DIR=/Users/you/Downloads/strava_export
ACTIVITY_POINTS_DIR=./data/activity_points

# COROS official MCP (OAuth 2.1 PKCE + remote MCP)
COROS_MCP_URL=https://mcp.coros.com/mcp
COROS_REDIRECT_URI=http://localhost:5173/oauth/coros/callback
# Optional: pin a dynamic-registration client id (otherwise auto-created under backend/data/)
# COROS_MCP_CLIENT_ID=
COROS_FIT_DAILY_LIMIT=50
COROS_ACTIVITY_LOOKBACK_DAYS=90
COROS_HEALTH_LOOKBACK_DAYS=28

# Email verification (soft — never blocks onboarding)
APP_BASE_URL=http://localhost:5173
# console (logs the link) | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=Advance Athlete Lab <no-reply@advanceathletelab.local>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
EMAIL_VERIFY_TTL_HOURS=48
EMAIL_VERIFY_RESEND_COOLDOWN_S=60

# AI coach — provider-agnostic. Without a key the coach uses deterministic rules.
# See docs/ai-provider-evaluation.md for how the default was chosen.
AI_PROVIDER=cursor
# Leave empty when you have no fallback key (avoids noisy failed attempts).
AI_FALLBACK_PROVIDER=
AI_REQUEST_TIMEOUT_S=90
# Cursor Pro — key from Cursor Dashboard → Integrations → User API Keys
# CURSOR_API_KEY=
# CURSOR_MODEL=auto
# Second Cursor model if the primary fails (same key; not a different provider)
# CURSOR_FALLBACK_MODEL=composer-2.5
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Logs redacted prompts/responses for debugging
AI_LOG_PROMPTS=false
# Show provider chain in /coach/status and log each provider attempt
AI_DEBUG=true
